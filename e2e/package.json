{
  "name": "@atmos/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "bun run test:smoke:stateless && bun run test:smoke:stateful",
    "test:smoke:stateless": "playwright test --project=chromium --reporter=line --output=test-results/smoke-stateless --grep @smoke --grep-invert @stateful",
    "test:smoke:stateful": "playwright test --project=chromium --reporter=line --output=test-results/smoke-stateful --grep @stateful --workers=1",
    "test:smoke:routes": "playwright test --project=chromium --reporter=line --output=test-results/routes e2e/tests/smoke/routes",
    "test:smoke:onboarding": "playwright test --project=chromium --reporter=line --output=test-results/onboarding e2e/tests/smoke/onboarding",
    "test:smoke:app-shell": "playwright test --project=chromium --reporter=line --output=test-results/app-shell e2e/tests/smoke/app-shell",
    "test:smoke:project": "playwright test --project=chromium --reporter=line --output=test-results/project e2e/tests/smoke/project",
    "test:smoke:settings": "playwright test --project=chromium --reporter=line --output=test-results/settings e2e/tests/smoke/settings",
    "test:smoke:workspace": "playwright test --project=chromium --reporter=line --output=test-results/workspace e2e/tests/smoke/workspace",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report reports/html",
    "install:browsers": "playwright install chromium",
    "install:browsers:with-deps": "playwright install --with-deps chromium",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^20.19.27",
    "typescript": "^5.9.3"
  }
}
