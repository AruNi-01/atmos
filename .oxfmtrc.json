{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "insertFinalNewline": true,
  "proseWrap": "preserve",
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./packages/ui/src/styles/globals.css",
    "functions": ["cn", "clsx", "cva"]
  },
  "ignorePatterns": [
    "vendor/**",
    "marketing/**",
    "skills/react-native-chart-kit",
    "**/.expo/**",
    "apps/mobile/ios/**",
    "apps/mobile/android/**",
    "**/.next/**",
    "**/dist/**",
    "**/out/**",
    "**/build/**",
    "**/.source/**",
    "**/next-env.d.ts",
    "**/coverage/**",
    "**/.wrangler/**",
    "**/.turbo/**",
    "**/playwright-report/**",
    "e2e/reports/**",
    "e2e/test-results/**",
    "target/**",
    "**/node_modules/**",
    "apps/desktop/src-tauri/**",
    "patches/**",
    "bun.lock",
    "Cargo.lock",
    "packages/ui/src/components/ui/tabs-subtle.tsx",
    "packages/ui/src/components/ui/color-picker.tsx",
    "packages/shared/src/terminal/links.ts",
    "packages/pt-design/src/host/catalog.ts",
    "packages/md-live/src/embed/unknown-directive.ts",
    "packages/agent-transcript/src/present.ts",
    "apps/web/src/shared/lib/oauth-callback-return.ts",
    "apps/web/src/features/md-live/lib/md-live-embed-nodes.ts",
    "apps/web/src/features/github/lib/agent-fix-prompts.ts",
    "apps/web/src/features/github/components/ActionsJobsList.tsx",
    "apps/web/src/features/browser/components/RunScript.tsx",
    "packages/relay/src/server-hub.ts",
    "apps/web/src/features/browser/lib/browser-helper/bridge.ts"
  ]
}
