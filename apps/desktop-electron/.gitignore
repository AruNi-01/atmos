# Local deps / build
node_modules/
dist/
release/

# Staged branded Electron.app for macOS `just dev-desktop-electron`
.cache/

# Synced from apps/desktop/src-tauri/icons at build time (see scripts/sync-icons.ts)
resources/icons/*
!resources/icons/README.md
# macOS 26 Liquid Glass Icon Composer package — source of truth (not synced from Tauri)
!resources/icons/icon.icon/
!resources/icons/icon.icon/**

# Staged Atmos Server + web for electron-builder extraResources
resources/runtime/

# Package-time CLI floor overlay (prepare-package from apps/cli/Cargo.toml).
# Do not write over the tracked pin in resources/desktop-use/.
resources/desktop-use-stage/

# Runtime logs
logs/

# Packaged cookie helper binary (staged by prepare-package from target/release)
resources/bin/*
!resources/bin/.gitkeep
main.js
