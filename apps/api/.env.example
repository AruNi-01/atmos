# Runtime environment: development | production
# In production, CORS_ORIGIN must be explicitly set
# RUST_ENV=production

# Server bind address
SERVER_HOST=0.0.0.0
SERVER_PORT=30303
ATMOS_PORT=30303
ATMOS_LOCAL_TOKEN=

# CORS allowed origins
# Use "*" to allow all origins (dev only), or comma-separated list:
# CORS_ORIGIN=https://atmos.example.com,https://app.example.com
CORS_ORIGIN=*
# Dev default origins (when CORS_ORIGIN unset):
# http://localhost:3030, http://127.0.0.1:3030, https://app.atmos.land, tauri://localhost, https://tauri.localhost

# Linear OAuth (public client + PKCE). Required for Settings → Connect with Linear.
# Create app at https://linear.app/settings/api — callback e.g.
#   http://localhost:3030/integrations/linear/callback
#   https://app.atmos.land/integrations/linear/callback
#   http://127.0.0.1:39217/integrations/linear/callback
# LINEAR_OAUTH_CLIENT_ID=
