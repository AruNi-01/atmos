    "@workspace/ui": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "fumadocs-core": "16.8.12",
    "fumadocs-mdx": "15.0.7",
    "fumadocs-ui": "16.8.12",
    "lucide-react": "^0.562.0",
    "next": "16.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
