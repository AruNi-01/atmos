{
  "expo": {
    "name": "Atmos",
    "slug": "atmos-mobile",
    "scheme": "atmos",
    "version": "0.1.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "primaryColor": "#0A0A0B",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "land.atmos.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Atmos uses the camera to scan a temporary pair QR from Desktop or Web."
      }
    },
    "android": {
      "package": "land.atmos.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#17191D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA"],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Atmos uses the camera to scan a temporary pair QR from Desktop or Web."
        }
      ],
      [
        "expo-dev-client",
        {
          "skipOnboarding": true,
          "toolsButton": false,
          "showMenuAtLaunch": false,
          "ios": {
            "skipOnboarding": true,
            "toolsButton": false,
            "showMenuAtLaunch": false
          },
          "android": {
            "skipOnboarding": true,
            "toolsButton": false,
            "showMenuAtLaunch": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
