{
  "expo": {
    "name": "Atmos",
    "slug": "atmos-mobile",
    "scheme": "atmos",
    "version": "0.1.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "primaryColor": "#0A0A0B",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "land.atmos.mobile",
      "deploymentTarget": "16.4",
      "infoPlist": {
        "NSCameraUsageDescription": "Atmos uses the camera to scan a temporary pair QR from Desktop or Web.",
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "Atmos.SceneDelegate"
              }
            ]
          }
        }
      }
    },
    "android": {
      "package": "land.atmos.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Atmos uses the camera to scan a temporary pair QR from Desktop or Web."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Atmos shows your photos so you can attach them to a chat.",
          "cameraPermission": "Atmos uses the camera to scan a temporary pair QR from Desktop or Web."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Atmos shows your recent photos so you can attach them to a chat.",
          "savePhotosPermission": "Atmos saves the token usage card to your photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-dev-client",
        {
          "skipOnboarding": true,
          "toolsButton": false,
          "showMenuAtLaunch": false,
          "ios": {
            "skipOnboarding": true,
            "toolsButton": false,
            "showMenuAtLaunch": false
          },
          "android": {
            "skipOnboarding": true,
            "toolsButton": false,
            "showMenuAtLaunch": false
          }
        }
      ],
      "./plugins/with-ios-pod-deployment-target.js"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
