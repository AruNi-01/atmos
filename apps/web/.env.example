# Backend API URL (REST)
# NEXT_PUBLIC_API_URL=http://100.x.x.x:30303

# Backend WebSocket URL
# NEXT_PUBLIC_WS_URL=ws://100.x.x.x:30303

# APP-016 Atmos Computer — Cloudflare relay HTTPS origin (optional default in Settings UI)
# NEXT_PUBLIC_ATMOS_RELAY_URL=https://relay.atmos.land

# APP-056 Atmos Hub (auth / devices / Linear credentials)
# Local: http://localhost:8787  Prod: https://hub.atmos.land
# NEXT_PUBLIC_ATMOS_HUB_URL=http://localhost:8787

# Force the hosted onboarding flow in local dev (`just dev-web`)
# Clear status use:
# ['atmos:v1:hosted:last-target', 'atmos:v1:inst:local:connection'].forEach((k) => localStorage.removeItem(k));location.reload();
# NEXT_PUBLIC_FORCE_HOSTED_ONBOARDING=1

# Tldraw license key
# NEXT_PUBLIC_TLDRAW_LICENSE_KEY=your_tldraw_license_key

# Linear OAuth public client id (not a secret). Create at https://linear.app/settings/api
# Callbacks: {origin}/integrations/linear/callback
# Local: .env.local
# CI/prod: GitHub Actions secret LINEAR_OAUTH_CLIENT_ID → NEXT_PUBLIC_LINEAR_OAUTH_CLIENT_ID
#   (same pattern as TLDRAW_LICENSE_KEY → NEXT_PUBLIC_TLDRAW_LICENSE_KEY)
# NEXT_PUBLIC_LINEAR_OAUTH_CLIENT_ID=
