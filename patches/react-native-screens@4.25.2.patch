+// Replace the iOS 26 glass sheet (and its corner stroke) with the screen color.
+// The effect belongs on the presentation, which slides with the presented view.
+// Detent backgroundEffect is a separate plate: it appears at full height first,
+// then the content springs up inside it.
+- (void)applySolidSheetFill:(UISheetPresentationController *)sheet
+{
+  if (@available(iOS 26.1, *)) {
+    if (sheet.backgroundEffect != nil) {
+      return;
+    }
+    UIColor *fill = self.backgroundColor;
+    if (fill == nil || CGColorGetAlpha(fill.CGColor) < 0.01) {
+      return;
+    }
+    sheet.backgroundEffect = [UIColorEffect effectWithColor:fill];
+  }
+}
