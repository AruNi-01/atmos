+// GFM tables on web are `w-full table-fixed`. Content-sized columns leave a
+// narrow grid; give the leftover container width to every column equally.
+- (void)distributeColumnsToContainerWidth:(CGFloat)innerWidth
+{
+  if (_colCount == 0 || innerWidth <= 1)
+    return;
+  if (fabs(_distributedInnerWidth - innerWidth) < 0.5)
+    return;
+
+  _distributedInnerWidth = innerWidth;
+  [self computeLayout];
+  if (_totalTableWidth <= 0 || _colWidths.count == 0 || _totalTableWidth + 0.5 >= innerWidth)
+    return;
+
+  CGFloat share = (innerWidth - _totalTableWidth) / (CGFloat)_colWidths.count;
+  NSMutableArray<NSNumber *> *expanded = [NSMutableArray arrayWithCapacity:_colWidths.count];
+  for (NSNumber *width in _colWidths) {
+    [expanded addObject:@(width.doubleValue + share)];
+  }
+  _colWidths = expanded;
+  _totalTableWidth = innerWidth;
+  [self renderGrid];
+}
