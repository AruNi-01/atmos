     codeAttributes[@"BlockLineHeight"] = @(UIFontLineHeight(blockFont));
 
     [output setAttributes:codeAttributes range:range];
+
+    // Room for the 6px horizontal chip padding. The background expands to cover it.
+    static const CGFloat kInlineCodePadX = 6.0;
+    NSUInteger last = NSMaxRange(range) - 1;
+    CGFloat trailing = 0;
+    NSNumber *existingKern = [output attribute:NSKernAttributeName atIndex:last effectiveRange:NULL];
+    if ([existingKern isKindOfClass:[NSNumber class]])
+      trailing = existingKern.doubleValue;
+    [output addAttribute:NSKernAttributeName value:@(trailing + kInlineCodePadX) range:NSMakeRange(last, 1)];
+    if (range.location > 0) {
+      NSUInteger prev = range.location - 1;
+      CGFloat leading = 0;
+      NSNumber *prevKern = [output attribute:NSKernAttributeName atIndex:prev effectiveRange:NULL];
+      if ([prevKern isKindOfClass:[NSNumber class]])
+        leading = prevKern.doubleValue;
+      [output addAttribute:NSKernAttributeName value:@(leading + kInlineCodePadX) range:NSMakeRange(prev, 1)];
+    }
   }
 }
 
