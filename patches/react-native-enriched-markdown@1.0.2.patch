+static void ENRMFenceInk(BOOL dark, CGFloat *r, CGFloat *g, CGFloat *b)
+{
+  CGFloat ink = dark ? (0xA3 / 255.0) : (0x52 / 255.0);
+  *r = ink;
+  *g = ink;
+  *b = ink;
+}
