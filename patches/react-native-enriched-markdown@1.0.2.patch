+  CGFloat share = (innerWidth - _totalTableWidth) / (CGFloat)_colWidths.count;
+  NSMutableArray<NSNumber *> *expanded = [NSMutableArray arrayWithCapacity:_colWidths.count];
+  for (NSNumber *width in _colWidths) {
+    [expanded addObject:@(width.doubleValue + share)];
+  }
+  _colWidths = expanded;
+  _totalTableWidth = innerWidth;
+  [self renderGrid];
+}
