+void ENRMDrawNamedFenceIcon(CGContextRef ctx, NSString *key, CGRect box, BOOL darkInk)
+{
+  if (!ctx || key.length == 0 || box.size.width <= 0 || box.size.height <= 0) {
+    return;
+  }
+  const ENRMFenceIconRow *row = ENRMFenceIconRowForKey(key);
+  const float *ops = row->ops;
+  int count = row->count;
+  CGContextSaveGState(ctx);
+  CGContextTranslateCTM(ctx, box.origin.x, box.origin.y);
+  CGContextScaleCTM(ctx, box.size.width / 16.0, box.size.height / 16.0);
+  CGMutablePathRef path = CGPathCreateMutable();
+  int i = 0;
+  while (i < count) {
+    int op = (int)ops[i++];
+    if (op == 1 && i + 1 < count) {
+      CGPathMoveToPoint(path, NULL, ops[i], ops[i + 1]);
+      i += 2;
+    } else if (op == 2 && i + 1 < count) {
+      CGPathAddLineToPoint(path, NULL, ops[i], ops[i + 1]);
