+// A tagged host can draw as one fill while its children stay on the window.
+// Runs 38986732141 and 38994588242 wrote that fill for every in-app frame.
+static BOOL RNSkiaImageIsUniform(UIImage *image) {
+  CGImageRef cgImage = image.CGImage;
+  if (!cgImage) {
+    return YES;
+  }
+  const size_t width = CGImageGetWidth(cgImage);
+  const size_t height = CGImageGetHeight(cgImage);
+  if (width < 2 || height < 2) {
+    return NO;
+  }
+  CFDataRef data = CGDataProviderCopyData(CGImageGetDataProvider(cgImage));
+  if (!data) {
+    return NO;
+  }
+  const UInt8 *bytes = CFDataGetBytePtr(data);
+  const size_t rowBytes = CGImageGetBytesPerRow(cgImage);
+  const size_t bytesPerPixel = CGImageGetBitsPerPixel(cgImage) / 8;
+  if (!bytes || bytesPerPixel < 4) {
+    CFRelease(data);
+    return NO;
+  }
+  const size_t samples[][2] = {
+      {width / 2, height / 2},
+      {width / 5, height / 5},
+      {(width * 4) / 5, height / 5},
+      {width / 5, (height * 4) / 5},
+      {(width * 4) / 5, (height * 4) / 5},
+      {2, height / 2},
+  };
+  const UInt8 *first =
+      bytes + samples[0][1] * rowBytes + samples[0][0] * bytesPerPixel;
+  BOOL uniform = YES;
+  for (size_t index = 1; index < sizeof(samples) / sizeof(samples[0]);
+       index++) {
+    const UInt8 *pixel = bytes + samples[index][1] * rowBytes +
+                         samples[index][0] * bytesPerPixel;
+    if (memcmp(pixel, first, 4) != 0) {
+      uniform = NO;
+      break;
+    }
+  }
+  CFRelease(data);
+  return uniform;
+}
+
+static UIImage *RNSkiaWindowImage(UIView *view, UIGraphicsImageRenderer *renderer) {
+  UIWindow *window = view.window;
+  if (window == nil) {
+    return nil;
+  }
+  CGPoint origin = [view convertPoint:CGPointZero toView:window];
+  return [renderer
+      imageWithActions:^(UIGraphicsImageRendererContext *_Nonnull context) {
+        CGContextTranslateCTM(context.CGContext, -origin.x, -origin.y);
+        [window.layer renderInContext:context.CGContext];
+      }];
+}
