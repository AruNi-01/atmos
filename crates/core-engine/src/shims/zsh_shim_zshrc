# Atmos Terminal Dynamic Title Shim - Zsh .zshrc
#
# This file lives in a temporary ZDOTDIR. It:
#   1. Restores ZDOTDIR to $HOME (so subsequent zsh operations are normal)
#   2. Sources the user's real .zshrc
#   3. Installs Atmos preexec/precmd hooks AFTER the user's config
#      (so our hooks aren't overridden by oh-my-zsh, starship, etc.)
#
# Protocol: \033]9999;TYPE:PAYLOAD\007
#   CMD_START:<command>  — a foreground command is starting
#   CMD_END:<cwd>        — the command finished, shell is idle at <cwd>
#
# Inside tmux, OSC sequences are wrapped in DCS passthrough so they
# reach the outer PTY reader (tmux drops unrecognized OSC codes).

# ── 1. Restore ZDOTDIR and load user's config ─────────────────────────
# Some shell integrations replace the startup shell with `exec` while the
# user's .zshrc is still loading. Make that replacement inherit the managed
# ZDOTDIR so the replacement zsh reaches this shim too. The temporary exec
# wrapper is removed after user startup completes.
__atmos_managed_zdotdir="$ZDOTDIR"
__atmos_exec_with_managed_zdotdir() {
    ZDOTDIR="$__atmos_managed_zdotdir" builtin exec "$@"
}
functions[exec]="$functions[__atmos_exec_with_managed_zdotdir]"

ZDOTDIR="$HOME"

# Source user's .zprofile if this is a login shell (tmux starts login shells)
if [[ -o login ]] && [ -f "$HOME/.zprofile" ]; then
    source "$HOME/.zprofile"
fi

[ -f "$HOME/.zshrc" ] && source "$HOME/.zshrc"

if [[ "$functions[exec]" == "$functions[__atmos_exec_with_managed_zdotdir]" ]]; then
    unfunction exec 2>/dev/null || true
fi
unfunction __atmos_exec_with_managed_zdotdir 2>/dev/null || true
unset __atmos_managed_zdotdir

# Atmos-local command wrappers must stay ahead of PATH changes from direnv,
# virtualenvs, and prompt hooks.
__atmos_ensure_shims_path() {
    [[ -z "${ATMOS_SHIMS_BIN:-}" || ! -d "$ATMOS_SHIMS_BIN" ]] && return
    local filtered_path=":$PATH:"
    local shim_path="${ATMOS_SHIMS_BIN%/}"
    local shim_path_slash="$shim_path/"
    while [[ "$filtered_path" == *":$shim_path:"* || "$filtered_path" == *":$shim_path_slash:"* ]]; do
        filtered_path="${filtered_path//":$shim_path:"/:}"
        filtered_path="${filtered_path//":$shim_path_slash:"/:}"
    done
    filtered_path="${filtered_path#:}"
    filtered_path="${filtered_path%:}"
    export ATMOS_GROK_REAL_PATH="$filtered_path"
    export PATH="$shim_path${filtered_path:+:$filtered_path}"
}
__atmos_ensure_shims_path

# PATH can be rewritten asynchronously after shell startup, and prompt
# frameworks may replace the hook arrays below. Keep manual `grok` launches
# routed through the Atmos wrapper with a session-local shell function instead.
unalias grok 2>/dev/null || true
grok() {
    __atmos_ensure_shims_path
    local wrapper="${ATMOS_SHIMS_BIN%/}/grok"
    if [[ -n "${ATMOS_SHIMS_BIN:-}" && -x "$wrapper" ]]; then
        command "$wrapper" "$@"
    else
        command grok "$@"
    fi
}

# ── 2. Atmos hooks ────────────────────────────────────────────────────
__atmos_send_meta() {
    if [ -n "$TMUX" ]; then
        # Inside tmux: wrap in DCS passthrough (\ePtmux;\e<esc-seq>\e\\)
        printf '\033Ptmux;\033\033]9999;%s:%s\007\033\\' "$1" "$2"
    else
        # Outside tmux: plain OSC
        printf '\033]9999;%s:%s\007' "$1" "$2"
    fi
}

# $3 in preexec is the full command string as typed by the user
__atmos_preexec() {
    __atmos_ensure_shims_path
    __atmos_send_meta "CMD_START" "$3"
}
__atmos_precmd()  {
    __atmos_ensure_shims_path
    __atmos_send_meta "CMD_END" "$PWD"
}

autoload -U add-zsh-hook
add-zsh-hook preexec __atmos_preexec
add-zsh-hook precmd  __atmos_precmd
